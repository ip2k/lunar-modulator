+def mulaw_encode(pcm, mags):
+    out = []
+    for v in pcm:
+        a, q = abs(v), 0
+        while q < MULAW_LEVELS and abs(mags[q + 1] - a) < abs(mags[q] - a):
+            q += 1
+        out.append(q | (0x80 if v < 0 and q else 0))
+    return out
