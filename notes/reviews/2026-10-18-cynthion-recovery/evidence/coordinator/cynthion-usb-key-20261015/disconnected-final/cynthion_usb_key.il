  process $141
    assign \key_bit [0] 1'0
    switch \tx_bit [3:0]
      case 4'0000
        assign \key_bit [0] 1'0
      case 4'0001
        assign \key_bit [0] 1'0
      case 4'0010
        assign \key_bit [0] 1'0
      case 4'0011
        assign \key_bit [0] 1'1
      case 4'0100
        assign \key_bit [0] 1'0
      case 4'0101
        assign \key_bit [0] 1'1
      case 4'0110
        assign \key_bit [0] 1'1
      case 4'0111
        assign \key_bit [0] 1'0
      case 4'1000
        assign \key_bit [0] 1'1
      case 4'1001
        assign \key_bit [0] 1'1
      case 4'1010
        assign \key_bit [0] 1'1
      case 4'1011
        assign \key_bit [0] 1'0
      case 4'1100
        assign \key_bit [0] 1'1
      case 4'1101
        assign \key_bit [0] 1'1
      case 4'1110
        assign \key_bit [0] 1'1
      case 4'1111
        assign \key_bit [0] 1'1
    end
  end

