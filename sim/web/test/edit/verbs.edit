# The edit layer's parity script (stage ED1): every record type and verb
# through the layer, refusals among them, and panel gestures between, at
# 64-frame blocks. fm1-sim-render --edit-run and test/edit.mjs play it the
# same way; their logs, screens and audio are compared.
@0 note 60 100
@4 edit param sound 0 0 2 0.25
@4 edit param sound 0 0 3 0.8
@6 edit level 0 70
@8 edit unit master 0 0 comp
@8 edit unit master 0 1 echo
@10 edit param master 0 0 1 -12
@12 edit cable 3 64 255 0 1 2 6000 0
@12 edit cable any 65 255 0 1 3 -4000 2000
@14 edit module 5 lfo
@14 edit param module 0 5 1 3.5
@16 edit swap master 0 0 master 0 1
@18 edit move master 0 0 master 0 1
@20 edit move module 0 5 module 0 6
@22 edit unit sound 1 0 macro
@22 edit level 1 55
@24 edit current 1
@24 off 60
@26 note 64 90
@30 edit on 0 1
@30 edit param mfx 0 0 2 3
@34 edit unit insert 0 1 drive
@36 edit swap insert 0 1 insert 1 0
@40 edit view fx sound=1 entry=4 page=1
@40 turn KNOB1 4
@44 button SEL 1
@44 button SEL 0
@44 turn SELECT 1
@48 edit view home sound=1 page=2
@48 turn KNOB2 -6
@52 edit view rack pos=1
@52 turn KNOB1 5
@56 edit unit sound 0 0 no-such-engine
@56 edit param sound 0 0 4000 1
@56 edit level 9 10
@56 edit view rack pos=9
@56 edit cable 0 200 255 0 1 2 1000 0
@58 edit module any env
@60 edit view matrix slot=4
@60 turn KNOB2 3
@64 edit view home sound=1 page=1
@64 off 64
@96 end
