@0 tog 0 0 69 100;tog 0 4 72 100;tog 0 8 76 100;tog 0 12 72 100;slen 0 0 15 -1 80
@0 alabel 0 0 synth:Volume;abaseq 0 0 90;aset 0 0 4 30 1;aset 0 0 8 127 1;aset 0 0 12 60 1
@0 play
@33000 stop
@44118 play
