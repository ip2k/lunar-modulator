#! rate=44118 block=128 tracks=4
# 08 Quantise and swing (R5, R6). fire = max(0, anchor + dev
# - (dev*quant ± 50)/100 + swing), less one loop length if it reaches the
# loop end. Swing delays odd 16ths (absolute step parity, counted in real
# 16ths under clip scale) by (pct-50)*(num*24/den)/60 ticks: at 80 % a 1X
# step 7 nudged +23 fires at 203 and wraps to 11.
# Track 0: an 8-step clip, notes nudged off the grid.
@0 tog 0 0 60 100
@0 tog 0 1 61 100
@0 tog 0 2 62 100
@0 tog 0 3 63 100
@0 tog 0 4 64 100
@0 tog 0 5 65 100
@0 tog 0 6 66 100
@0 tog 0 7 67 100
@0 clen 0 8
@0 enudge 0 1 1 -1 5
@0 enudge 0 2 2 -1 -3
@0 enudge 0 3 3 -1 10
@0 enudge 0 5 5 -1 -11
@0 enudge 0 7 7 -1 23
# Track 1: double speed; swing lands on its steps 2 and 6.
@0 tog 1 0 48 100
@0 tog 1 1 49 100
@0 tog 1 2 50 100
@0 tog 1 3 51 100
@0 clen 1 4
@0 cscl 1 2 1
# Track 2: half speed; its steps are never odd real 16ths, so no swing.
@0 tog 2 0 72 100
@0 tog 2 1 73 100
@0 tog 2 2 74 100
@0 tog 2 3 75 100
@0 clen 2 4
@0 cscl 2 1 2
@0 play
@44000 swing 80
@88300 cq 0 50
@132400 cq 0 100
@132400 swing 66
@176700 stop
