diff --git a/src/return_r01_proto.c b/src/return_r01_proto.c
new file mode 100644
index 0000000..5881b40
--- /dev/null
+++ b/src/return_r01_proto.c
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: MIT
+// Fixed return-r01 ROM-only CDC protocol. Never linked into recovery firmware.
+#include "transporter_proto.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "pico/stdlib.h"
+#include "hardware/sync.h"
+#include "tusb.h"
+
+#include "jieli_uboot.h"
+#include "pio_host.h"
+
+#ifndef FM1T_RETURN_R01
+#error "return_r01_proto.c must only be linked into the fixed ROM variant"
+#endif
+
+#define DATA_ITF 1
+#define RX_LINE_MAX 32
+#define TX_SIZE 256
+#define UPLOAD_TIMEOUT_US 5000000ull
+#define READY_TIMEOUT_US 9000000ull
+#define R01_ADDR 0x01C02000u
+#define R01_ARG 1u
+#define R01_LEN 512u
+
+typedef enum {
+    WAIT_READY, READY_PENDING, READY, UPLOAD_COLLECT, UPLOAD_PENDING,
+    UPLOADED, CALL_PENDING, TERMINAL
+} phase_t;
+
+static volatile phase_t phase;
+static char rx_line[RX_LINE_MAX];
+static unsigned rx_len;
+static uint8_t __attribute__((aligned(4))) payload[R01_LEN];
+static unsigned payload_len;
+static uint64_t upload_started_us;
+static uint64_t ready_poll_started_us;
+static volatile bool req_pending;
+static volatile phase_t req_phase;
+static uint32_t ready_mount;
+
+// Core 1 writes this bounded queue; core 0 drains it to CDC interface 02.
+static uint8_t tx[TX_SIZE];
+static volatile uint32_t tx_head, tx_tail;
+
+static void tx_line(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void tx_line(const char *fmt, ...) {
+    char line[96];
+    va_list ap;
+    va_start(ap, fmt);
+    int n = vsnprintf(line, sizeof(line) - 1, fmt, ap);
+    va_end(ap);
+    if (n < 0 || n > (int)sizeof(line) - 2) return;
+    line[n++] = '\n';
+    uint32_t h = tx_head;
+    if ((uint32_t)n > TX_SIZE - (h - tx_tail)) return; // fail closed on full queue
+    for (int i = 0; i < n; i++) tx[(h + (uint32_t)i) & (TX_SIZE - 1)] = (uint8_t)line[i];
+    __dmb();
+    tx_head = h + (uint32_t)n;
+}
+
+void fm1_proto_drain(void) {
+    if (!tud_cdc_n_connected(DATA_ITF)) {
+        tx_tail = tx_head;
+        return;
+    }
+    for (;;) {
+        uint32_t h = tx_head;
+        __dmb();
+        uint32_t t = tx_tail;
+        if (h == t) break;
+        uint32_t n = h - t;
+        uint32_t avail = tud_cdc_n_write_available(DATA_ITF);
+        if (!avail) break;
+        uint32_t idx = t & (TX_SIZE - 1);
+        if (n > TX_SIZE - idx) n = TX_SIZE - idx;
+        if (n > avail) n = avail;
+        n = tud_cdc_n_write(DATA_ITF, &tx[idx], n);
+        __dmb();
+        tx_tail = t + n;
+    }
+    tud_cdc_n_write_flush(DATA_ITF);
+}
+
+static void fail_rx(void) {
+    phase = TERMINAL;
+    req_phase = TERMINAL;
+    __dmb();
+    req_pending = true;
+}
+
+// Core 0: never accepts arbitrary addresses, lengths, commands or retries.
+void fm1_proto_rx(const char *buf, unsigned len) {
+    bool queue = false;
+    phase_t queued = TERMINAL;
+    for (unsigned i = 0; i < len; i++) {
+        if (phase == TERMINAL) continue;
+        if (phase == UPLOAD_COLLECT) {
+            payload[payload_len++] = (uint8_t)buf[i];
+            if (payload_len == R01_LEN) {
+                phase = UPLOAD_PENDING;
+                queue = true;
+                queued = UPLOAD_PENDING;
+            }
+            continue;
+        }
+        // A request cannot be pipelined or followed by extra bytes.
+        if (queue || req_pending || phase == READY_PENDING || phase == UPLOAD_PENDING ||
+            phase == CALL_PENDING) {
+            fail_rx();
+            return;
+        }
+        char c = buf[i];
+        if (c == '\n') {
+            rx_line[rx_len] = 0;
+            rx_len = 0;
+            if (phase == WAIT_READY && !strcmp(rx_line, "rr01-ready")) {
+                phase = READY_PENDING;
+                queue = true;
+                queued = READY_PENDING;
+            } else if (phase == READY && !strcmp(rx_line, "rr01-upload")) {
+                payload_len = 0;
+                upload_started_us = time_us_64();
+                phase = UPLOAD_COLLECT;  // attempt is latched before first payload byte
+            } else if (phase == UPLOADED && !strcmp(rx_line, "rr01-call")) {
+                phase = CALL_PENDING;
+                queue = true;
+                queued = CALL_PENDING;
+            } else {
+                fail_rx();
+                return;
+            }
+        } else if (c < 0x21 || c > 0x7e || rx_len >= RX_LINE_MAX - 1) {
+            fail_rx();
+            return;
+        } else {
+            rx_line[rx_len++] = c;
+        }
+    }
+    if (queue) {
+        req_phase = queued;
+        __dmb();
+        req_pending = true;
+    }
+}
+
+static bool exact_payload(void) {
+    if (payload_len != R01_LEN || payload[0] != 0x80 || payload[1] != 0x00) return false;
+    for (unsigned i = 2; i < R01_LEN; i++) if (payload[i]) return false;
+    return true;
+}
+
+// Core 1: no idle keepalive and no target command after the call attempt.
+void fm1_proto_poll(void) {
+    if (phase != WAIT_READY && !tud_cdc_n_connected(DATA_ITF)) phase = TERMINAL;
+    if (phase == UPLOAD_COLLECT && time_us_64() - upload_started_us > UPLOAD_TIMEOUT_US) {
+        phase = TERMINAL;
+    }
+    if (!req_pending) {
+        if (phase == TERMINAL) fm1_host_return_terminal();
+        return;
+    }
+    __dmb();
+    phase_t request = req_phase;
+    if (request == READY_PENDING && phase == READY_PENDING &&
+        !fm1_host_return_ready_generation()) {
+        if (!ready_poll_started_us) ready_poll_started_us = time_us_64();
+        if (time_us_64() - ready_poll_started_us < READY_TIMEOUT_US) return;
+    }
+    req_pending = false;
+    if (phase == TERMINAL || request == TERMINAL) {
+        phase = TERMINAL;
+        fm1_host_return_terminal();
+        tx_line("ERR rr01-terminal");
+        return;
+    }
+    if (request == READY_PENDING && phase == READY_PENDING) {
+        uint32_t mount = fm1_host_return_ready_generation();
+        if (!mount) {
+            phase = TERMINAL;
+            fm1_host_return_terminal();
+            tx_line("ERR rr01-ready");
+            return;
+        }
+        ready_mount = mount;
+        phase = READY;
+        tx_line("OK rr01-ready v=1 build=rr01-pico-v1 mount=%lu", (unsigned long)mount);
+        return;
+    }
+    if (request == UPLOAD_PENDING && phase == UPLOAD_PENDING) {
+        if (!exact_payload() || !fm1_host_return_claim_upload(ready_mount)) {
+            phase = TERMINAL;
+            fm1_host_return_terminal();
+            tx_line("ERR rr01-upload");
+            return;
+        }
+        bool ok = jl_rom_mem_write(R01_ADDR, payload, R01_LEN);
+        // Core 0 may reject pipelined/extra CDC bytes while the BOT call
+        // blocks on core 1. A late BOT success cannot restore that session.
+        if (ok && phase == UPLOAD_PENDING && !req_pending)
+            ok = fm1_host_return_upload_complete(ready_mount);
+        if (!ok || phase != UPLOAD_PENDING || req_pending) {
+            req_pending = false;
+            phase = TERMINAL;
+            fm1_host_return_terminal();
+            tx_line("ERR rr01-upload");
+            return;
+        }
+        phase = UPLOADED;
+        tx_line("OK rr01-upload mount=%lu", (unsigned long)ready_mount);
+        return;
+    }
+    if (request == CALL_PENDING && phase == CALL_PENDING) {
+        if (!fm1_host_return_claim_call(ready_mount)) {
+            phase = TERMINAL;
+            fm1_host_return_terminal();
+            tx_line("ERR rr01-call");
+            return;
+        }
+        bool ok = jl_rom_jump(R01_ADDR, R01_ARG);
+        if (ok && phase == CALL_PENDING && !req_pending)
+            ok = fm1_host_return_call_complete(ready_mount);
+        if (phase != CALL_PENDING || req_pending) ok = false;
+        req_pending = false;
+        phase = TERMINAL;
+        fm1_host_return_terminal();
+        if (ok) tx_line("OK rr01-call mount=%lu", (unsigned long)ready_mount);
+        else tx_line("ERR rr01-call");
+        return;
+    }
+    phase = TERMINAL;
+    fm1_host_return_terminal();
+    tx_line("ERR rr01-terminal");
+}
