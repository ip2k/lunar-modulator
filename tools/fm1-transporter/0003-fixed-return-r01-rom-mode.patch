diff --git a/src/return_r01_proto.c b/src/return_r01_proto.c
new file mode 100644
index 0000000..3b071df
--- /dev/null
+++ b/src/return_r01_proto.c
@@ -0,0 +1,313 @@
+// SPDX-License-Identifier: MIT
+// Fixed return-r01 ROM-only CDC protocol. Never linked into recovery firmware.
+#include "transporter_proto.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "pico/stdlib.h"
+#include "pico/critical_section.h"
+#include "tusb.h"
+
+#include "jieli_uboot.h"
+#include "pio_host.h"
+
+#ifndef FM1T_RETURN_R01
+#error "return_r01_proto.c must only be linked into the fixed ROM variant"
+#endif
+
+#define DATA_ITF 1
+#define RX_LINE_MAX 32
+#define TX_SIZE 256
+#define UPLOAD_TIMEOUT_US 5000000ull
+#define READY_TIMEOUT_US 9000000ull
+#define R01_ADDR 0x01C02000u
+#define R01_ARG 1u
+#define R01_LEN 512u
+
+typedef enum {
+    WAIT_READY, READY_PENDING, READY_REPLY, READY, UPLOAD_COLLECT,
+    UPLOAD_PENDING, UPLOADED_REPLY, UPLOADED, CALL_PENDING, TERMINAL
+} phase_t;
+
+static critical_section_t state_lock;
+static phase_t phase;
+static char rx_line[RX_LINE_MAX];
+static unsigned rx_len;
+static uint8_t __attribute__((aligned(4))) payload[R01_LEN];
+static unsigned payload_len;
+static uint64_t upload_started_us;
+static uint64_t ready_poll_started_us;
+static bool req_pending;
+static phase_t req_phase;
+static bool connected, seen_connected;
+static uint32_t ready_mount;
+
+// Core 1 writes this bounded queue; core 0 drains it to CDC interface 02.
+static uint8_t tx[TX_SIZE];
+static uint32_t tx_head, tx_tail;
+
+void fm1_proto_init(void) { critical_section_init(&state_lock); }
+
+// Call only with state_lock held. The TX ring is copied under the same lock;
+// TinyUSB calls and formatting happen outside it.
+static bool tx_enqueue_locked(const char *line, unsigned n) {
+    if (!n || n > 96 || n > TX_SIZE - (tx_head - tx_tail)) return false;
+    for (unsigned i = 0; i < n; i++) tx[(tx_head + i) & (TX_SIZE - 1)] = (uint8_t)line[i];
+    tx_head += n;
+    return true;
+}
+
+static unsigned format_line(char line[96], const char *fmt, va_list ap) {
+    int n = vsnprintf(line, 95, fmt, ap);
+    if (n < 0 || n > 94) return 0;
+    line[n++] = '\n';
+    return (unsigned)n;
+}
+
+static void tx_line(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void tx_line(const char *fmt, ...) {
+    char line[96];
+    va_list ap;
+    va_start(ap, fmt);
+    unsigned n = format_line(line, fmt, ap);
+    va_end(ap);
+    if (!n) return;
+    critical_section_enter_blocking(&state_lock);
+    (void)tx_enqueue_locked(line, n); // full queue yields host timeout, never false OK
+    critical_section_exit(&state_lock);
+}
+
+void fm1_proto_drain(void) {
+    // This function runs only on core 0, which owns the TinyUSB device stack.
+    bool live = tud_cdc_n_connected(DATA_ITF);
+    critical_section_enter_blocking(&state_lock);
+    connected = live;
+    if (live) seen_connected = true;
+    if (!live && seen_connected && phase != WAIT_READY) {
+        phase = TERMINAL;
+        req_pending = false;
+        tx_tail = tx_head;
+    }
+    critical_section_exit(&state_lock);
+    if (!live) {
+        return;
+    }
+    for (;;) {
+        uint32_t avail = tud_cdc_n_write_available(DATA_ITF);
+        if (!avail) break;
+        uint8_t chunk[64];
+        critical_section_enter_blocking(&state_lock);
+        uint32_t copied_tail = tx_tail;
+        uint32_t n = tx_head - tx_tail;
+        if (n > sizeof(chunk)) n = sizeof(chunk);
+        if (n > avail) n = avail;
+        for (uint32_t i = 0; i < n; i++) chunk[i] = tx[(tx_tail + i) & (TX_SIZE - 1)];
+        critical_section_exit(&state_lock);
+        if (!n) break;
+        uint32_t accepted = tud_cdc_n_write(DATA_ITF, chunk, n);
+        if (accepted > n) accepted = n;
+        critical_section_enter_blocking(&state_lock);
+        // A simultaneous terminal/disconnect may have discarded the ring.
+        // Never advance into that new state after the unlocked USB call.
+        if (tx_tail == copied_tail) tx_tail += accepted;
+        critical_section_exit(&state_lock);
+        if (!accepted) break;
+    }
+    tud_cdc_n_write_flush(DATA_ITF);
+    critical_section_enter_blocking(&state_lock);
+    if (tx_head == tx_tail) {
+        if (phase == READY_REPLY) phase = READY;
+        else if (phase == UPLOADED_REPLY) phase = UPLOADED;
+    }
+    critical_section_exit(&state_lock);
+}
+
+static void fail_rx_locked(void) {
+    phase = TERMINAL;
+    tx_tail = tx_head; // retract an OK line still waiting in the Pico ring
+    req_phase = TERMINAL;
+    req_pending = true;
+}
+
+// Core 0: never accepts arbitrary addresses, lengths, commands or retries.
+void fm1_proto_rx(const char *buf, unsigned len) {
+    bool queue = false;
+    phase_t queued = TERMINAL;
+    critical_section_enter_blocking(&state_lock);
+    connected = seen_connected = true; // receiving on CDC1 is a live core-0 observation
+    for (unsigned i = 0; i < len; i++) {
+        if (phase == TERMINAL) continue;
+        if (phase == UPLOAD_COLLECT) {
+            payload[payload_len++] = (uint8_t)buf[i];
+            if (payload_len == R01_LEN) {
+                phase = UPLOAD_PENDING;
+                queue = true;
+                queued = UPLOAD_PENDING;
+            }
+            continue;
+        }
+        // A request cannot be pipelined or followed by extra bytes.
+        if (queue || req_pending || phase == READY_PENDING || phase == READY_REPLY ||
+            phase == UPLOAD_PENDING || phase == UPLOADED_REPLY || phase == CALL_PENDING) {
+            fail_rx_locked();
+            break;
+        }
+        char c = buf[i];
+        if (c == '\n') {
+            rx_line[rx_len] = 0;
+            rx_len = 0;
+            if (phase == WAIT_READY && !strcmp(rx_line, "rr01-ready")) {
+                phase = READY_PENDING;
+                queue = true;
+                queued = READY_PENDING;
+            } else if (phase == READY && !strcmp(rx_line, "rr01-upload")) {
+                payload_len = 0;
+                upload_started_us = time_us_64();
+                phase = UPLOAD_COLLECT;  // attempt is latched before first payload byte
+            } else if (phase == UPLOADED && !strcmp(rx_line, "rr01-call")) {
+                phase = CALL_PENDING;
+                queue = true;
+                queued = CALL_PENDING;
+            } else {
+                fail_rx_locked();
+                break;
+            }
+        } else if (c < 0x21 || c > 0x7e || rx_len >= RX_LINE_MAX - 1) {
+            fail_rx_locked();
+            break;
+        } else {
+            rx_line[rx_len++] = c;
+        }
+    }
+    if (queue && phase != TERMINAL) {
+        req_phase = queued;
+        req_pending = true;
+    }
+    critical_section_exit(&state_lock);
+}
+
+static bool exact_payload(void) {
+    if (payload_len != R01_LEN || payload[0] != 0x80 || payload[1] != 0x00) return false;
+    for (unsigned i = 2; i < R01_LEN; i++) if (payload[i]) return false;
+    return true;
+}
+
+// The phase transition and complete reply enqueue are one short cross-core
+// transaction. No formatting, BOT, TinyUSB call or wait occurs under this lock.
+static bool publish_success(phase_t expected, phase_t next, const char *line) {
+    unsigned n = (unsigned)strlen(line);
+    critical_section_enter_blocking(&state_lock);
+    bool ok = phase == expected && !req_pending && connected &&
+              tx_enqueue_locked(line, n);
+    if (ok) phase = next;
+    else { phase = TERMINAL; req_pending = false; }
+    critical_section_exit(&state_lock);
+    return ok;
+}
+
+static void finish_error(const char *reply) {
+    critical_section_enter_blocking(&state_lock);
+    phase = TERMINAL;
+    req_pending = false;
+    critical_section_exit(&state_lock);
+    fm1_host_return_terminal();
+    tx_line("%s", reply);
+}
+
+// Core 1: no idle keepalive and no target command after the call attempt.
+void fm1_proto_poll(void) {
+    bool pending;
+    phase_t request, current;
+    critical_section_enter_blocking(&state_lock);
+    if (phase == UPLOAD_COLLECT &&
+        time_us_64() - upload_started_us > UPLOAD_TIMEOUT_US) phase = TERMINAL;
+    current = phase;
+    pending = req_pending;
+    request = req_phase;
+    if (pending) req_pending = false;
+    critical_section_exit(&state_lock);
+
+    if (current == TERMINAL || (request == TERMINAL && pending)) {
+        fm1_host_return_terminal();
+        if (pending) tx_line("ERR rr01-terminal");
+        return;
+    }
+    if (!pending) return;
+
+    if (request == READY_PENDING && current == READY_PENDING) {
+        uint32_t mount = fm1_host_return_ready_generation();
+        if (!mount) {
+            if (!ready_poll_started_us) ready_poll_started_us = time_us_64();
+            if (time_us_64() - ready_poll_started_us < READY_TIMEOUT_US) {
+                critical_section_enter_blocking(&state_lock);
+                if (phase == READY_PENDING && !req_pending) {
+                    req_phase = READY_PENDING;
+                    req_pending = true;
+                }
+                critical_section_exit(&state_lock);
+                return;
+            }
+            finish_error("ERR rr01-ready");
+            return;
+        }
+        ready_mount = mount;
+        char line[96];
+        int n = snprintf(line, sizeof(line),
+                         "OK rr01-ready v=1 build=rr01-pico-v1 mount=%lu\n",
+                         (unsigned long)mount);
+        if (n > 0 && n < (int)sizeof(line) &&
+            publish_success(READY_PENDING, READY_REPLY, line)) return;
+        finish_error("ERR rr01-ready");
+        return;
+    }
+    if (request == UPLOAD_PENDING && current == UPLOAD_PENDING) {
+        if (!exact_payload()) {
+            finish_error("ERR rr01-upload");
+            return;
+        }
+        // The audited host claim only changes core-1 state. Pair it with the
+        // protocol check so an already terminal CDC session cannot start BOT.
+        critical_section_enter_blocking(&state_lock);
+        bool claimed = phase == UPLOAD_PENDING && !req_pending && connected &&
+                       fm1_host_return_claim_upload(ready_mount);
+        critical_section_exit(&state_lock);
+        if (!claimed) {
+            finish_error("ERR rr01-upload");
+            return;
+        }
+        bool ok = jl_rom_mem_write(R01_ADDR, payload, R01_LEN);
+        if (ok) ok = fm1_host_return_upload_complete(ready_mount);
+        char line[96];
+        int n = snprintf(line, sizeof(line), "OK rr01-upload mount=%lu\n",
+                         (unsigned long)ready_mount);
+        if (ok && n > 0 && n < (int)sizeof(line) &&
+            publish_success(UPLOAD_PENDING, UPLOADED_REPLY, line)) return;
+        finish_error("ERR rr01-upload");
+        return;
+    }
+    if (request == CALL_PENDING && current == CALL_PENDING) {
+        critical_section_enter_blocking(&state_lock);
+        bool claimed = phase == CALL_PENDING && !req_pending && connected &&
+                       fm1_host_return_claim_call(ready_mount);
+        critical_section_exit(&state_lock);
+        if (!claimed) {
+            finish_error("ERR rr01-call");
+            return;
+        }
+        bool ok = jl_rom_jump(R01_ADDR, R01_ARG);
+        if (ok) ok = fm1_host_return_call_complete(ready_mount);
+        char line[96];
+        int n = snprintf(line, sizeof(line), "OK rr01-call mount=%lu\n",
+                         (unsigned long)ready_mount);
+        if (ok && n > 0 && n < (int)sizeof(line) &&
+            publish_success(CALL_PENDING, TERMINAL, line)) {
+            fm1_host_return_terminal();
+            return;
+        }
+        finish_error("ERR rr01-call");
+        return;
+    }
+    finish_error("ERR rr01-terminal");
+}
